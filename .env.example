# Copie para .env e ajuste. Valores só para desenvolvimento local.

# Postgres (superusuário, usado só pelo script de init)
POSTGRES_PASSWORD=admin_pw
POSTGRES_DB=stockroute

# Uma senha por role de serviço (infra/postgres/init/01-roles-schemas.sh).
# Elas entram literais nas URLs de conexão: use só [A-Za-z0-9_-], ou caracteres
# como # / @ : quebram a URL (ou codifique-os na URL, ex.: # vira %23).
CATALOG_DB_PASSWORD=catalog_pw
ORDERS_DB_PASSWORD=orders_pw
INTEGRATION_DB_PASSWORD=integration_pw

# Conexão de cada serviço: role <serviço>_svc, schema <serviço>
CATALOG_DATABASE_URL=postgresql://catalog_svc:catalog_pw@localhost:18432/stockroute?schema=catalog
ORDERS_DATABASE_URL=postgresql://orders_svc:orders_pw@localhost:18432/stockroute?schema=orders
INTEGRATION_DATABASE_URL=postgresql://integration_svc:integration_pw@localhost:18432/stockroute?schema=integration

# Segredo do JWT (HS256) do gateway; o `npm run token` assina com o mesmo valor.
# Só para desenvolvimento: troque por um valor longo e aleatório fora daqui.
JWT_SECRET=dev-only-jwt-secret-change-me
