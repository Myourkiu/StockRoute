// Schema do catalog. O domínio (produtos, variações, estoque) chega na Etapa 2;
// por ora só existe a migration inicial, que marca o ponto zero do histórico.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  // Imports sem extensão: o Jest (ts-jest) e o rspack resolvem os .ts direto.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}
